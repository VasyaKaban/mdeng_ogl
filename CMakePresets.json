{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "Windows-base",
            "hidden": true,
            "displayName": "Windows base preset",
            "description": "Windows base preset with Ninja generator",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_CXX_FLAGS": "/EHsc /utf-8 /Zi /Zc:preprocessor /std:c++20",
                "SDL_OPENGL": "OFF",
                "SDL_OPENGLES": "OFF",
                "SDL_DIRECTX": "OFF",
                "SDL_VULKAN": "OFF",
                "SDL_TEST": "OFF"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Windows"
                    ]
                }
            }
        },
        {
            "inherits": "Windows-base",
            "name": "Windows-debug",
            "displayName": "Windows debug preset",
            "description": "Windows debug preset",
            "binaryDir": "${sourceDir}/build/windows/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Windows"
                    ]
                }
            }
        },
        {
            "inherits": "Windows-base",
            "name": "Windows-release",
            "displayName": "Windows release preset",
            "description": "Windows release preset",
            "binaryDir": "${sourceDir}/build/windows/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Windows"
                    ]
                }
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Windows Debug",
            "configurePreset": "Windows-debug"
        },
        {
            "name": "Windows Release",
            "configurePreset": "Windows-release"
        }
    ]
}